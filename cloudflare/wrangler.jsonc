{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitness-hevy-webhook",
  "account_id": "da7965eb00ae1ec17c868f8ebd661056",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "triggers": {
    "crons": ["2-59/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitness-hevy",
      "database_id": "b5c6e244-376c-479a-9174-56e36af8b8ae",
      "migrations_dir": "migrations"
    }
  ]
}
